# Copy to deploy.env and fill in your values.
# deploy.env is gitignored — never commit real host/key paths.

# --- AWS provisioning (required for make bootstrap / make provision-ec2) ---
AWS_REGION=us-east-1
AWS_KEY_NAME=your-ec2-key-pair-name
SSH_KEY=~/.ssh/your-key.pem

# EC2 settings
EC2_INSTANCE_NAME=freelance-job-agent
EC2_INSTANCE_TYPE=t4g.micro
# EC2_INSTANCE_TYPE=t3.micro   # use with: make build-linux-amd64 bootstrap

# --- Deploy connection (optional if using make provision-ec2) ---
# provision-ec2 writes these to deploy.state automatically
# EC2_HOST=ec2-user@<PUBLIC-IP>

# Architecture override (auto-set by provision-ec2 based on instance type)
# GOARCH_LINUX=arm64
# GOARCH_LINUX=amd64

# Your public IP for SSH security group (auto-detected if empty)
# MY_IP=203.0.113.10
