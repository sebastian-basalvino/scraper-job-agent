# IMAP
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_INBOX=INBOX
IMAP_PROCESSED_FOLDER=Processed

# Connectors (comma-separated: linkedin, workana, remotive)
ENABLED_SOURCES=linkedin

# Mail senders
LINKEDIN_SENDER=jobs-noreply@linkedin.com
WORKANA_SENDER=noreply@workana.com

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-haiku-4-5

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# App
SQLITE_PATH=./data/offers.db
SCORE_THRESHOLD=65
